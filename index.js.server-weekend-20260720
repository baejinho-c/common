// Secu Scan API -> sports-server
app.all(/^\/api\/secu\/scan(?:\/.*)?$/, (req, res) => {
  const forwardedFor = String(
    req.headers['x-forwarded-for'] || ''
  ).trim()

  const realIp = String(
    req.headers['x-real-ip'] || ''
  ).trim()

  const socketIp = String(
    req.socket?.remoteAddress ||
    req.connection?.remoteAddress ||
    ''
  ).replace(/^::ffff:/, '')

  const clientIp =
    forwardedFor.split(',')[0].trim() ||
    realIp ||
    socketIp

  if (clientIp) {
    req.headers['x-real-ip'] = clientIp
    req.headers['x-forwarded-for'] = forwardedFor || clientIp
  }

  console.log('[secu-scan gateway ip]', {
    clientIp,
    forwardedFor: req.headers['x-forwarded-for'],
    realIp: req.headers['x-real-ip'],
    socketIp,
  })

  proxy.web(
    req,
    res,
    {
      target: 'http://127.0.0.1:5001',
      changeOrigin: true,
      xfwd: true
    },
    (err) => {
      console.error('[secu-scan proxy error]', err)

      if (!res.headersSent) {
        res.status(502).json({
          success: false,
          error: 'Secu Scan upstream unavailable'
        })
      }
    }
  )
})


